# ── Trợ lý production — biến môi trường ──
# Provider LLM: 'foundry' (mặc định, keyless) hoặc 'openai' (Azure OpenAI /v1)
ASSISTANT_LLM_PROVIDER=foundry

# Foundry (keyless qua DefaultAzureCredential)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4o

# Azure OpenAI /v1 (khi ASSISTANT_LLM_PROVIDER=openai, hoặc cho web_search + text2sql)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=                 # bỏ trống nếu dùng keyless
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Mock API nội bộ (đặt phòng họp / log work) — chạy offline
MOCK_API_BASE_URL=http://localhost:8000

# Đường dẫn dữ liệu local (mặc định trong data/, có thể bỏ trống)
# SALES_DB_PATH=
# INTERNAL_DOCS_DIR=
# CHART_OUTPUT_DIR=
