# =====================================================================
# .env.example — sao chép thành .env rồi điền giá trị thật (KHÔNG commit .env)
# Mỗi file lab chỉ cần một phần biến ở đây, không phải toàn bộ.
# =====================================================================

# --- Microsoft Foundry project (dùng cho agents, projects, Responses) ---
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL=gpt-4o                       # tên model deployment mặc định

# --- Azure OpenAI (chat completions cổ điển qua openai SDK) ---
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key-neu-dung-api-key-thay-vi-keyless>
AZURE_OPENAI_API_VERSION=2025-04-01-preview    # CHỈ cho path classic AzureOpenAI; v1 API (/openai/v1/) KHÔNG cần api_version
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1       # tạo/sửa ảnh (07/08); có bản mới hơn gpt-image-1.5 / gpt-image-2
AZURE_OPENAI_VIDEO_DEPLOYMENT=sora-2            # tạo video (07/09); catalog hiện là sora-2 (preview), "sora" trơn đã cũ

# --- Foundry Models non-OpenAI (MaaS) — gọi qua OpenAI SDK /v1 (KHÔNG dùng azure-ai-inference đã retire) ---
FOUNDRY_MODELS_ENDPOINT=https://<your-foundry>.openai.azure.com/openai/v1/   # endpoint OpenAI/v1
FOUNDRY_MODELS_API_KEY=<key-neu-khong-dung-keyless>
FOUNDRY_NON_OPENAI_MODEL=mistral-large-4-latest   # vd (tên catalog đổi theo thời gian); hoặc Mistral-Large-3, Llama, DeepSeek, Cohere...
# Keyless: DefaultAzureCredential + token scope https://ai.azure.com/.default

# --- Azure AI Search / Foundry IQ (RAG) ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<admin-or-query-key>
AZURE_SEARCH_INDEX=ai103-index
AZURE_SEARCH_SEMANTIC_CONFIG=ai103-semantic  # tên semantic configuration trên index (06/02)
AZURE_SEARCH_KNOWLEDGE_BASE=ai103-kb        # Foundry IQ knowledge base (06/04)
AI_SEARCH_PROJECT_CONNECTION_ID=<connection-id-AI-Search-trong-project>  # cho agent tool (06/05)

# --- Content Safety ---
CONTENT_SAFETY_ENDPOINT=https://<your-safety>.cognitiveservices.azure.com/
CONTENT_SAFETY_API_KEY=<key>

# --- Vision (Image Analysis) ---
VISION_ENDPOINT=https://<your-vision>.cognitiveservices.azure.com/
VISION_API_KEY=<key>

# --- Language (Text Analytics + CLU) ---
LANGUAGE_ENDPOINT=https://<your-language>.cognitiveservices.azure.com/
LANGUAGE_API_KEY=<key>
CLU_PROJECT_NAME=<clu-project>
CLU_DEPLOYMENT_NAME=<clu-deployment>

# --- Translator ---
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
TRANSLATOR_API_KEY=<key>
TRANSLATOR_REGION=southeastasia

# --- Speech ---
SPEECH_KEY=<key>
SPEECH_REGION=southeastasia

# --- Document Intelligence (tên cũ: Form Recognizer) ---
DOC_INTELLIGENCE_ENDPOINT=https://<your-di>.cognitiveservices.azure.com/
DOC_INTELLIGENCE_API_KEY=<key>

# --- Content Understanding ---
CONTENT_UNDERSTANDING_ENDPOINT=https://<your-cu>.services.ai.azure.com/
CONTENT_UNDERSTANDING_API_KEY=<key>

# --- Service principal / app registration (lab 01/07; app NGOÀI Azure: on-prem, CI-CD) ---
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<application-client-id-cua-app-registration>
AZURE_CLIENT_SECRET=<client-secret>          # cất kỹ, xoay vòng định kỳ, KHÔNG commit
BLOB_CONTAINER_NAME=<ten-container-tuy-chon>

# --- Quản lý/Deploy model qua ARM + fine-tuning (lab 01/02, 01/06) ---
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<resource-group>
AOAI_ACCOUNT_NAME=<ten-azure-openai-account>

# --- Storage blob (document translation + indexer skillset RAG + provisioning 00/01) ---
BLOB_CONNECTION_STRING=<connection-string>
STORAGE_ACCOUNT_NAME=<ten-storage-account>
AZURE_LOCATION=southeastasia

# --- RBAC (gán quyền bằng code - lab 00/02..06) ---
RBAC_PRINCIPAL_ID=<object-id-cua-user-hoac-managed-identity>
# Chọn role theo việc:
#   Cognitive Services OpenAI User  -> keyless gọi chat/embedding/image (Azure OpenAI)  [default repo]
#   Foundry User                    -> dùng Foundry project/agent (lab 03-06)
#   Cognitive Services User         -> chỉ ĐỌC key của resource (không phải quyền gọi model)
RBAC_ROLE_NAME=Cognitive Services OpenAI User
# 00/03 scopes & built-in roles (tuỳ chọn):
RBAC_SCOPE_LEVEL=rg                          # subscription | rg | resource
RBAC_TARGET_RESOURCE_ID=<id-resource-khi-scope=resource>
# 00/04 managed identity keyless:
MI_PRINCIPAL_ID=<principal-id-cua-managed-identity>
# 00/06 audit & remove (tuỳ chọn):
RBAC_ASSIGNMENT_NAME_TO_DELETE=<name-GUID-cua-assignment-can-xoa>

# --- Agents nâng cao (MCP tool + hosted agent) ---
MCP_SERVER_URL=https://gitmcp.io/Azure/azure-rest-api-specs
PORT=8080

# --- Agent tools: Bing grounding (03/07) ---
BING_PROJECT_CONNECTION_ID=<connection-id-tab-Connections-cua-project>

# --- Agent tools: Azure Functions (03/09) ---
STORAGE_QUEUE_SERVICE_ENDPOINT=https://<storage>.queue.core.windows.net
STORAGE_INPUT_QUEUE_NAME=agent-input
STORAGE_OUTPUT_QUEUE_NAME=agent-output

# --- Observability / tracing (lab 09) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>
